{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "rnhighpass-quiz",
  "account_id": "966575298a7a680846a981e76ecbf7d4",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 模擬考站(exam.rnhighpass.com)：同一份程式碼，但 SITE_MODE=mock 只露出 /mock-exam。
  // 部署指令 pnpm cf:deploy:exam。主站 rnhighpass.com 與 quiz.rnhighpass.com 不受影響。
  "env": {
    "exam": {
      "name": "rnhighpass-exam",
      "vars": { "SITE_MODE": "mock" },
      "routes": [{ "pattern": "exam.rnhighpass.com", "custom_domain": true }],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      }
    }
  }
}
