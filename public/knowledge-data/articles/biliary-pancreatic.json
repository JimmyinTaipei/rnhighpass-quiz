","value":"膽結石"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"女性"}]},{"type":"text","value":"比男性多（「男性較多」是錯的）；膽囊炎大部分由"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"結石"}]},{"type":"text","value":"造成；不是幽門螺旋桿菌"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"膽囊手術後要監測腹脹、腹部僵硬、嘔吐等"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"腹膜炎"}]},{"type":"text","value":"徵象；引流液墨綠（棕綠）色是正常"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"T 型管：引流液"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"棕綠色"}]},{"type":"text","value":"、量"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"逐漸減少"}]},{"type":"text","value":"、活動時引流袋"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"低於腰部"}]},{"type":"text","value":"；「每日定時沖洗」是錯的"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"膽結石合併總膽管阻塞：糞便"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"灰白色"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"腹腔鏡膽囊切除：回家即可下床走動；"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"右肩痛"}]},{"type":"text","value":"是腹腔充氣（二氧化碳刺激橫膈）；「1 年內避免舉重物」錯（B 或 D 都給分）；術後清流質可喝"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"清米湯"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"口服膽囊攝影：檢查前採"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"低脂"}]},{"type":"text","value":"飲食（前一晚無脂晚餐）；急性膽囊炎"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"不是"}]},{"type":"text","value":"適應症"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"黃疸：茶色尿、皮膚搔癢、鞏膜黃；"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"橘色便"}]},{"type":"text","value":"是錯的（阻塞性是灰白便）"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"阻塞性黃疸"}]},{"type":"text","value":"的 "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"PT 延長"}]},{"type":"text","value":"、"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"ALP 上升"}]},{"type":"text","value":"；"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"溶血性黃疸的 PT 正常"}]},{"type":"text","value":"（PT 延長是錯的）；溶血性黃疸不是肝硬化造成；尿膽紅素只在"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"結合型"}]},{"type":"text","value":"上升時出現（溶血性沒有）"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"膽囊癌"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"好發老年女性"}]},{"type":"text","value":"（「好發於年輕人」錯）、多為腺癌、早期症狀像膽囊炎、可分浸潤型與黴菌型（蕈狀）"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"急性胰臟炎：常見原因"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"膽道疾病與飲酒"}]},{"type":"text","value":"，膽汁與胰液逆流；"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"澱粉酶與脂肪酶都上升"}]},{"type":"text","value":"、"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"血鈣下降"}]},{"type":"text","value":"（「血鈣上升」錯）、血糖上升；疼痛在"},