":"text","value":"PT 延長"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"T 型管"}]},{"type":"text","value":"：引流液"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"棕綠色"}]},{"type":"text","value":"、量逐漸減少；引流袋低於傷口；"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"不可常規沖洗"}]},{"type":"text","value":"；夾管測試無腹痛、發燒、黃疸才拔管"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"急性胰臟炎"}]},{"type":"text","value":"：主因"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"膽結石"}]},{"type":"text","value":"與"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"酒精"}]},{"type":"text","value":"；"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"上腹中央劇痛輻射到背部"}]},{"type":"text","value":"、前傾或側臥屈膝較舒服；"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"澱粉酶與脂肪酶上升"}]},{"type":"text","value":"、"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"血鈣下降"}]},{"type":"text","value":"、血糖上升；出血性可見 "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Cullen（肚臍周圍瘀青）"}]},{"type":"text","value":"、"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Grey Turner（腰側瘀青）"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"慢性胰臟炎"}]},{"type":"text","value":"：主因"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"長期酗酒"}]},{"type":"text","valu