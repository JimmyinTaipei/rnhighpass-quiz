":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"原則"},{"type":"text","value":"\n"},{"type":"element","tagName":"ol","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"新生兒穩定後就可以開始（不是固定 6 小時後），剖腹產也鼓勵"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"不論餵母乳或配方奶"}]},{"type":"text","value":"都可以"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"以"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"母嬰需要"}]},{"type":"text","value":"為中心：母親"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"非常疲憊"}]},{"type":"text","value":"或身體不適想休息時，可以把嬰兒"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"暫時推回嬰兒室"}]},{"type":"text","value":"；不是一定要強制同室"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"鼓勵"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"父親與家人"}]},{"type":"text","value":"（含祖父母、兄姊）參與，注意洗手、生病者暫不接觸"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"嬰兒"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"仰睡"}]},{"type":"text","value":"、在自己的小床上"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"教父母觀察嬰兒的呼吸、膚色與異常徵象，告訴他們如何求助"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"k-questions","properties":{"tag":"","adm":"","keyword":"","drug":"","group":"","ids":"115-1_OP_012,106-2_makeup_OP_026,105-1_OP_025","limit":"","qkey":"postpartum-psychosocial-adaptation#rooming-in"},"children":[]}]}},{"id":"separated","depth":3,"number":"(三)","title":"新生兒需要住院時","children":[],"content":{"type":"root","children":[{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"嬰兒因黃疸照光、早產或生病住院 → 母親容易"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"自責、覺得自己不是好媽媽"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"措施：評估她對自己身體與寶寶照護的擔心；"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"鼓勵並安排探視"}]},{"type":"text","value":"、"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"眼對眼與身體接觸"}]},{"type":"text","value":"、袋鼠護理、擠母乳送去；運用支持系統讓她能把心力放在嬰兒身上；"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"不因怕感染而不鼓勵探視"}]}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"k-questions","properties":{"tag":"","adm":"","keyword":"","drug":"","group":"","ids":"109-2_OP_023","limit":"","qkey":"postpartum-psychosocial-adaptation#separated"},"children":[]}]}}],"content":{"type":"root","children":[]}},{"id":"father","depth":2,"number":"六、","title":"父親","children":[],"content":{"type":"root","children":[{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"父親對新生兒的依附稱為"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"全神貫注"}]},{"type":"text","value":"（engrossment，Greenberg 與 Morris 1974）："},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"專注凝視"}]},{"type":"text","value":"、想抱想摸、覺得嬰兒"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"很完美"}]},{"type":"text","value":"、強烈被吸引、對自己當爸爸感到驕傲與自尊提升"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"112-1 題的選項把 engrossment 寫成 engorgement（那個字是"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"脹奶"}]},{"type":"text","value":"），作答時看中文「全神貫注」"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"新手爸爸常因"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"沒經驗而害怕"}]},{"type":"text","value":"（「她軟軟的，我不敢抱」）："},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"循序漸進"}]},{"type":"text","value":"，先"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"撫觸"}]},{"type":"text","value":"建立熟悉感，再示範與練習抱嬰兒、換尿布、沐浴；肯定他的努力"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"有幫助的行為：陪伴哺乳、對嬰兒說話、換尿布、抱嬰兒、肌膚接觸；"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"只問血型"}]},{"type":"text","value":"這類資訊沒有情感互動，最無助於依附"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"也要注意父親的疲倦與產後情緒（父親也可能有產後憂鬱）"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"k-questions","properties":{"tag":"","adm":"","keyword":"","drug":"","group":"","ids":"112-1_OP_024,109-2_OP_022,108-1_OP_020","limit":"","qkey":"postpartum-psychosocial-adaptation#father"},"children":[]}]}},{"id":"siblings-family","depth":2,"number":"七、","title":"手足與家庭","children":[],"content":{"type":"root","children":[{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"手足競爭"}]},{"type":"text","value":"(sibling rivalry)：新生兒出生，大孩子怕失去父母的愛，可能出現"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"退化行為"}]},{"type":"text","value":"（尿床、吸手指、要喝奶瓶、要人抱）、生氣、攻擊嬰兒、黏人"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"措施"},{"type":"text","value":"\n"},{"type":"element","tagName":"ol","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"懷孕時就讓大孩子知道並參與（看超音波、準備嬰兒用品）"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"新生兒出生後，"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"讓大孩子（包含 2 歲以下）來看、撫摸嬰兒"}]},{"type":"text","value":"，在照顧中給他"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"小任務"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"父母"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"每天保留時間單獨陪大孩子"}]},{"type":"text","value":"（例如嬰兒睡時唸書給他聽）；訪客也關心大孩子"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"接受暫時的退化，不責罵；給予肯定"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"大孩子的作息盡量不變；不要在這時候剛好戒尿布或換房間"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"媽媽"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"同時以乳房安撫大寶與新生兒"}]},{"type":"text","value":"、大寶睡時抱著新生兒凝視，都是正常的依附表現"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","pro