":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"不跨越無菌區；換藥時專心操作，說明在操作前完成（"},{"type":"element","tagName":"k-link","properties":{"target":"asepsis-sterilization"},"children":[{"type":"text","value":"無菌技術與消毒滅菌"}]},{"type":"text","value":"）"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"敷料選擇"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ol","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"親水性膠體敷料"}]},{"type":"text","value":"：吸收少量分泌物並維持濕潤"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"含銀敷料"}]},{"type":"text","value":"：適用於"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"感染性傷口"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"藻膠敷料"}]},{"type":"text","value":"：適用於"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"滲液多"}]},{"type":"text","value":"的傷口"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"傳統紗布乾掉會黏住傷口，換藥時造成傷害"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"}]}]}},{"id":"cellulitis","depth":3,"number":"(二)","title":"蜂窩性組織炎","children":[],"content":{"type":"root","children":[{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"ch