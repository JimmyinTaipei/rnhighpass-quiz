ype":"text","value":"(見下方說明)"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"心因性休克："},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"肺動脈楔壓上升"}]},{"type":"text","value":"、CVP 上升、心輸出量下降；全身血管張力下降是"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"分布性"}]},{"type":"text","value":"休克，不是心因性；創傷出血不是心因性休克的原因"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"休克代償：交感神經使血管收縮、呼吸加快加深、RAAS 活化；"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"不會促進腸胃蠕動"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"休克時腎素分泌"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"上升"}]},{"type":"text","value":"(不是下降)，尿量減少"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"休克對肝臟：早期血糖"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"上升"}]},{"type":"text","value":"、進行期血糖下降、乳酸轉換下降、"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"代謝性酸中毒"}]},{"type":"text","value":"(不是鹼中毒)"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"進行期或不可逆期：PaCO₂ "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"> 40 mmHg"}]},{"type":"text","value":"(呼吸代償失敗)；心跳、呼吸正常、pH > 7.50 都不是"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"兒童燒傷急救期休克的主因是"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"低血容積性"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text",