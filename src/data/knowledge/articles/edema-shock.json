","value":"(心肌梗塞、心律不整、瓣膜病)、"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"阻塞性"}]},{"type":"text","value":"(肺栓塞、心包膜填塞、張力性氣胸)、"},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"分布性"}]},{"type":"text","value":"(敗血性、過敏性、神經性)"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"低血容積性休克 "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"CVP ↓、SVR ↑"}]},{"type":"text","value":"；心因性 "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"CVP ↑、PCWP ↑"}]},{"type":"text","value":"；分布性 "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"SVR ↓"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"休克三期："},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"代償期"}]},{"type":"text","value":"(交感與 RAAS 撐住血壓) → "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"進行期"}]},{"type":"text","value":"(血壓下降、代謝性酸中毒) → "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"不可逆期"}]},{"type":"text","value":"(多重器官衰竭)"}]},{"type":"text","value":"\n"}]}]}},{"id":"starling","depth":2,"number":"二、","title":"微血管的液體交換","children":[],"content":{"type":"root","children":[{"type":"element","tagName":"k-figure","properties":{"src":"/knowledge-images/starling-edema.svg","alt":"微血管的液體交換：小動脈端靜水壓大於膠體滲透壓而濾出，小靜脈端膠體滲透壓大於靜水壓而回收，剩餘由淋巴管帶走；下方為水腫的四個機轉"},"children":[]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"靜水壓"}]},{"type":"text","value":"(hydrostatic pre